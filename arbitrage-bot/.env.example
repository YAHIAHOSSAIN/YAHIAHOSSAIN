# Ethereum node (Alchemy / Infura / your own node). WebSocket or HTTPS.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Private RPC for sending tx (keeps them out of the public mempool)
SEND_RPC_URL=https://rpc.flashbots.net/fast

# Use a NEW wallet that only holds gas money. Never commit this file.
PRIVATE_KEY=

# Address printed by `npm run deploy`
ARB_CONTRACT=

# Pairs of the same tokens on different DEXes. Groups separated by ';'
# Example: WETH/USDC on Uniswap V2 and SushiSwap (verify on etherscan before using)
PAIR_GROUPS=0xB4e16d0168e52d35CaCD2c6185b44281Ec28C9Dc,0x397FF1542f962076d0BFE58eA045FfA2d347ACa0

# Extra profit margin above gas cost, in wei (0.001 ETH = 1000000000000000)
MIN_PROFIT_WEI=1000000000000000

# true = only print opportunities. Set to false only after testing.
DRY_RUN=true
