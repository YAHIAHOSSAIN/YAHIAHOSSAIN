{
  "name": "mexc-dex-arb",
  "version": "1.0.0",
  "private": true,
  "description": "MEXC spot <-> Ethereum DEX (0x / 1inch) inventory arbitrage bot",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "report": "node dist/report.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:0x": "tsx scripts/check-0x-quote.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.6.1",
    "ethers": "6.17.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
