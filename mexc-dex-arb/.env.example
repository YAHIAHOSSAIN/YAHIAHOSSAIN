# Copy to .env, fill in, then: chmod 600 .env
# The bot refuses to start in live mode if .env is readable by other users.

# paper (default: no orders, no transactions) | live (real money)
# Run paper for at least 7 days first, then live with MAX_TRADE_USD=50.
MODE=paper

# inventory = hold tokens on both sides, trade both legs at the same moment (default, NO withdrawals)
# transfer  = buy on MEXC -> WITHDRAW to wallet -> sell on DEX. Needs a withdraw-enabled MEXC key and
#             an unhedged position for 5-60+ min. Refuses to start unless ALLOW_WITHDRAWALS=yes.
STRATEGY=inventory
ALLOW_WITHDRAWALS=no

# ---------- Ethereum ----------
# Your own RPC (Alchemy / Infura / QuickNode). Used for reading and simulation.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Private RPC for sending (never the public mempool): MEV Blocker or Flashbots Protect
SEND_RPC_URL=https://rpc.mevblocker.io
# SEND_RPC_URL=https://rpc.flashbots.net/fast
# NEW hot wallet used only by this bot. Keep only the trading inventory in it.
PRIVATE_KEY=

# ---------- DEX aggregator ----------
# 0x (https://dashboard.0x.org) or 1inch (https://portal.1inch.dev)
DEX_AGGREGATOR=0x
ZEROX_API_KEY=
ONEINCH_API_KEY=

# ---------- MEXC ----------
# API key: Spot TRADE permission ONLY. NO withdraw permission. IP-whitelisted to your VPS.
# (Only for STRATEGY=transfer + ALLOW_WITHDRAWALS=yes would withdraw be needed - not recommended.)
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_TAKER_FEE=0.0005

# ---------- Telegram ----------
# Create a bot with @BotFather, send it any message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  (message.chat.id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Your own Telegram user id (message.from.id). Commands are obeyed only from this user, in a private chat.
TELEGRAM_ADMIN_ID=

# ---------- Watchlist ----------
# Optional: only these tokens (MEXC base symbols). Empty = auto-discover by volume.
WATCHLIST=
WATCHLIST_MAX=8
MIN_DEX_TVL_USD=200000
MIN_MEXC_VOLUME_USD=500000

# ---------- Profit rules ----------
# Trade only if net > max(MIN_PROFIT_USD, MIN_PROFIT_PCT% of size)
MIN_PROFIT_USD=15
MIN_PROFIT_PCT=0.5
DEX_SLIPPAGE_BPS=30
CEX_SLIPPAGE_BPS=20
SAFETY_MARGIN_USD=2
PRIORITY_FEE_GWEI=1

# ---------- Risk limits ----------
MAX_TRADE_USD=50
MIN_TRADE_USD=25
MAX_TRADES_PER_DAY=20
DAILY_LOSS_LIMIT_USD=30
# Skip a trade if losing this % of its size (+ gas) would break what is left of the daily loss budget
WORST_CASE_LOSS_PCT=5
MAX_GAS_GWEI=40
MAX_CONSECUTIVE_FAILS=3
MIN_ETH_FOR_GAS=0.01
TX_TIMEOUT_SEC=60

# ---------- Transfer strategy ----------
SCAN_INTERVAL_SEC=20
# Cheap pre-filter (MEXC ask vs DexScreener price) before exact quotes
SCAN_MIN_GAP_PCT=3
# Bigger "gaps" are almost always a wrong token or a dead pool
SCAN_MAX_GAP_PCT=30
SCAN_EXACT_QUOTES=5
# Price-move reserve while the withdrawal travels (150 = 1.5%)
TRANSFER_DRIFT_BPS=150
TRANSFER_TIMEOUT_MIN=90
MAX_OPEN_TRANSFERS=1
# On arrival, do not auto-sell at more than this % loss vs the MEXC cost: hold + alert (/sell <id> forces)
TRANSFER_MAX_LOSS_PCT=3

DB_PATH=data/bot.sqlite
