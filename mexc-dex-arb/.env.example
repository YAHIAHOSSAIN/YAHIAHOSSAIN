# Copy to .env, fill in, then: chmod 600 .env
# The bot refuses to start in live mode if .env is readable by other users.

# paper (default: no orders, no transactions) | live (real money)
# Run paper for at least 7 days first, then live with MAX_TRADE_USD=50.
MODE=paper

# inventory = hold tokens on both sides, trade both legs at the same moment (default, NO withdrawals)
# transfer  = buy on MEXC -> WITHDRAW to wallet -> sell on DEX. Needs a withdraw-enabled MEXC key and
#             an unhedged position for 5-60+ min. Refuses to start unless ALLOW_WITHDRAWALS=yes.
STRATEGY=inventory

# ethereum | base | bsc | arbitrum  (one chain per process; pm2: BOT_CHAINS=base pm2 start ecosystem.config.cjs)
# Run `npm run networks` first: it shows which MEXC tokens can be deposited/withdrawn on each chain.
# One MEXC account = one chain: two chains on the same account share balances but keep separate
# loss limits and inventory caps, so each can spend the full daily budget (round-3, M2).
CHAIN=ethereum
# Optional: override the chain's default DEX stable (USDC on Ethereum/Base/Arbitrum, USDT on BSC).
# STABLE_ADDRESS=
# Fast chains scan on a timer (Base/BSC/Arbitrum default 1000 ms); Ethereum scans once per block.
# TICK_MS=1000
ALLOW_WITHDRAWALS=no

# Unlimited token approval (MaxUint256) instead of exact-amount approval: the first sale of a
# token approves once, later sales skip the approve tx (~12s saved per sale). Risk: a compromised
# spender contract could drain the whole token balance from the wallet. Default no (exact approvals).
UNLIMITED_APPROVAL=no

# Transfer-universe volume rules: MEXC 24h volume floor for the scanned universe (default $500k),
# DEX 24h volume floor (DexScreener h24; 0 = off), and a cap on universe size (0 = no cap).
# Live twin (2026-11-22): MEXC $20k + DEX $20k, top 100 by MEXC volume.
MIN_DEX_VOLUME_USD=0
TRANSFER_UNIVERSE_MAX=0
# Depth filter (Phase 1): skip tokens whose best DEX pool holds less than this
# (0 = off), or whose trade size would move the pool more than
# DEPTH_MAX_IMPACT_BPS (70 = 0.7%). Unknown pool liquidity (tvl 0) is fail-open.
# DEPTH_MAX_SIZE_PCT caps the trade size as a % of the pool (default 1%).
MIN_POOL_LIQUIDITY_USD=150000
DEPTH_MAX_IMPACT_BPS=70
DEPTH_MAX_SIZE_PCT=1

# ---------- Ethereum ----------
# Your own RPC (Alchemy / Infura / QuickNode). Used for reading and simulation.
# Must be the same chain as CHAIN (the bot checks the chain id at startup).
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Private RPC for sending (never the public mempool): MEV Blocker or Flashbots Protect.
# These are Ethereum mainnet only: on Base/BSC/Arbitrum point SEND_RPC_URL at a private RPC for
# THAT chain (or the chain's own RPC). The bot fails loudly at startup if the chain id mismatches.
SEND_RPC_URL=https://rpc.mevblocker.io
# SEND_RPC_URL=https://rpc.flashbots.net/fast
# NEW hot wallet used only by this bot. Keep only the trading inventory in it.
PRIVATE_KEY=

# ---------- DEX aggregator ----------
# 0x (https://dashboard.0x.org) or 1inch (https://portal.1inch.dev)
# One or several: 0x, kyber, 1inch, velora, openocean. With several (e.g. 0x,kyber) the best quote AFTER gas is used.
# Kyber, Velora and OpenOcean need no API key. Velora free tier: 1 RPS / 5,000 req/day (pass partner=, no signup);
# OpenOcean public: 2 RPS, plus a tiered trading fee (0.01–0.5% by pair) baked into its quotes — confirm on paper first.
# NOT enabled live by the Phase-3 change: add velora,openocean to DEX_AGGREGATOR only after the paper check (see CHANGES.md).
# Each aggregator has its own quote budget (calls per second):
DEX_AGGREGATOR=0x
KYBER_CLIENT_ID=mexc-dex-arb
QUOTE_RPS_0X=4
QUOTE_RPS_KYBER=3
QUOTE_RPS_1INCH=1
QUOTE_RPS_VELORA=1
QUOTE_RPS_OPENOCEAN=2
ZEROX_API_KEY=
ONEINCH_API_KEY=

# ---------- MEXC ----------
# API key: Spot TRADE permission ONLY. NO withdraw permission. IP-whitelisted to your VPS.
# (Only for STRATEGY=transfer + ALLOW_WITHDRAWALS=yes would withdraw be needed - not recommended.)
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_TAKER_FEE=0.0005

# ---------- Telegram ----------
# Create a bot with @BotFather, send it any message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  (message.chat.id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Your own Telegram user id (message.from.id). Commands are obeyed only from this user, in a private chat.
TELEGRAM_ADMIN_ID=

# ---------- Bot board (arb.alphahelper.online) — default-ON reporting ----------
# By default the bot reports its HOT WALLET ADDRESS + a public-safe snapshot
# (status, trades, PnL — never a key, tx hash or order id) to
# https://arb.alphahelper.online/api/ingest every INGEST_INTERVAL_SEC, so the
# board owner can see who runs this code: one page per wallet address, with a
# summary (total users, active users, total volume/profit). The owner's page
# is key-gated; public per-bot pages need the bot's pairing code (/pairing in
# Telegram shows the code; /pairing-new rotates it) and show at most a short
# fingerprint of the address, never the full address.
# Your own receiver instead: set INGEST_URL=http://127.0.0.1:3102/api/ingest
# (same machine as the status server). Turn reporting OFF with INGEST_URL=off
# (an empty value means "use the default", not "off").
#INGEST_URL=https://arb.alphahelper.online/api/ingest
#INGEST_INTERVAL_SEC=25

# ---------- Watchlist ----------
# Optional: only these tokens (MEXC base symbols). Empty = auto-discover by volume.
WATCHLIST=
WATCHLIST_MAX=8
MIN_DEX_TVL_USD=200000
MIN_MEXC_VOLUME_USD=500000

# ---------- Profit rules ----------
# Trade only if net > max(MIN_PROFIT_USD, MIN_PROFIT_BPS of size). net already subtracts the per-symbol
# MEXC taker fee (exchangeInfo), DEX fees, gas, CEX slippage and the safety margin.
MIN_PROFIT_USD=0.25
MIN_PROFIT_BPS=20
# Phase 5 — dynamic hurdle: Ethereum gas is $4+ per trade, L2 gas is cents.
# When set (> 0), Ethereum uses this bps instead of MIN_PROFIT_BPS; Arbitrum /
# BSC / Base always use MIN_PROFIT_BPS. 0 = off (default: current behaviour
# everywhere). Suggested on the Ethereum twin only: MIN_PROFIT_BPS_ETH=50.
# MIN_PROFIT_BPS_ETH=0
DEX_SLIPPAGE_BPS=30
CEX_SLIPPAGE_BPS=5
# safety margin = max(SAFETY_MARGIN_USD, SAFETY_MARGIN_BPS of size)
SAFETY_MARGIN_USD=0
SAFETY_MARGIN_BPS=10
# A CAP: the tip used is the median of recent blocks' tips (eth_feeHistory), at most this.
PRIORITY_FEE_GWEI=1
# Phase 5 — optional extra builder tip (gwei) on top of the median tip, e.g. to bid
# for inclusion through a private RPC. 0 = off (default: the median-tip gas path is unchanged).
# BUILDER_TIP_GWEI=0
# OP-stack L1 data fee reserve (USD) added to every gas estimate. 0 on Ethereum/Arbitrum.
# On Base, set it to a typical legs.l1_fee from a past trade (usually a few cents).
L1_FEE_USD=0
# Floor for the MEXC taker fee; the bot uses max(this, the symbol's own fee: most pairs 0.08%, some 0.20%).
# MEXC_TAKER_FEE=0.0005

# ---------- Risk limits ----------
MAX_TRADE_USD=50
# Multi-size quoting: base size (default MAX_TRADE_USD/2); 0.5x and 2x are also tried when the base size's
# gross gap reaches MULTISIZE_TRIGGER x the hurdle.
# BASE_TRADE_USD=25
MULTISIZE_TRIGGER=0.7
MIN_TRADE_USD=25
MAX_TRADES_PER_DAY=20
DAILY_LOSS_LIMIT_USD=30
# Skip a trade if losing this % of its size (+ gas) would break what is left of the daily loss budget
WORST_CASE_LOSS_PCT=5
MAX_GAS_GWEI=40
MAX_CONSECUTIVE_FAILS=3
MIN_ETH_FOR_GAS=0.01
TX_TIMEOUT_SEC=60

# ---------- Transfer strategy ----------
SCAN_INTERVAL_SEC=20
# Cheap pre-filter (MEXC ask vs DexScreener price) before exact quotes
SCAN_MIN_GAP_PCT=3
# Bigger "gaps" are almost always a wrong token or a dead pool
SCAN_MAX_GAP_PCT=30
SCAN_EXACT_QUOTES=5
# Price-move reserve while the withdrawal travels (150 = 1.5%)
TRANSFER_DRIFT_BPS=150
TRANSFER_TIMEOUT_MIN=90
MAX_OPEN_TRANSFERS=1
# On arrival, do not auto-sell at more than this % loss vs the MEXC cost: hold + alert (/sell <id> forces)
TRANSFER_MAX_LOSS_PCT=3

# ---------- Monitoring and inventory (phase 1) ----------
# Fast chains log every evaluation (100k+ rows/day on Base): keep 7 days, not 30 (~1-2 GB at 30).
# The report only looks back 7 days. Pruning runs at startup and every 6 h.
OPP_RETENTION_DAYS=7
# Paper mode books the net after this delay + a re-quote (not the first quote)
PAPER_LATENCY_MS=1000
INVENTORY_PER_SIDE_X=3
MAX_TOKEN_SHARE_PCT=50
SKEW_K=0.75
REBALANCE_AFTER_MIN=30
# A side counts as "low" below this multiple of the trade size (default 1):
# after REBALANCE_AFTER_MIN it gets ONE rebalance ticket (the bot never moves
# funds itself). If the other side cannot cover the deficit, the ticket's
# shortfall warning says to deposit fresh funds instead.
REBALANCE_LOW_X=1
# DEX-DEX detection ONLY (Phase 4): when yes, each inventory tick also prices
# stable->token and token->stable through BestOf and logs any cross-pool
# spread. It NEVER trades, sends or approves anything — detection + logging
# only. Default no.
DEX_ARB_ENABLED=no

# Default: data/<CHAIN>.sqlite (one database per chain)
# DB_PATH=data/ethereum.sqlite
